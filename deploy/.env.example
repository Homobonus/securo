# Copy to .env next to docker-compose.yml and fill in. Keep .env private.

# Public address of the app, exactly as typed in the browser.
FRONTEND_URL=https://securo.example.com

# Signs logins and encrypts stored secrets (store and bank tokens).
# Generate once:  openssl rand -hex 32
# Changing it later logs everyone out and makes stored store/bank tokens
# unreadable, so every connection has to be signed in again.
SECRET_KEY=

# Database password. Generate once:  openssl rand -hex 24
# Only used inside the Docker network; set it before the first start,
# the database keeps the password it was created with.
POSTGRES_PASSWORD=

# Passkeys: the bare domain and the full origin of FRONTEND_URL.
WEBAUTHN_RP_ID=securo.example.com
WEBAUTHN_ORIGIN=https://securo.example.com

# Images built by the fork's "Fork images" workflow.
SECURO_IMAGE_PREFIX=ghcr.io/homobonus
# `latest`, or `sha-xxxxxxx` to pin one build (and to roll back).
SECURO_TAG=latest

# Port on 127.0.0.1 that the host's nginx proxies to.
FRONTEND_PORT=3000

# Optional: European banks through Enable Banking (key file in ./secrets/).
# ENABLE_BANKING_APP_ID=
